# Copie ce fichier en .env.local et remplis les valeurs.
# Sans ces clés, l'application tourne en « mode démo » (progression locale, paiement et coach simulés).

# URL publique du site (utilisée pour les retours de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, côté serveur uniquement (webhook Stripe)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe : Developers > API keys, puis un prix récurrent par offre et période
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=

# Coach IA : clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
